# BitHarbor — copy to .env and fill in.
# The app NEVER scrapes trackers directly; it queries your Jackett/Prowlarr
# via Torznab. Indexer ids below are examples — pick your own from FMHY.

# Jackett example (per docs: Dashboard -> Copy Torznab Feed for "all"):
# TORZNAB_URL=http://jackett:9117/api/v2.0/indexers/all/results/torznab
# Prowlarr example:
# TORZNAB_URL=http://prowlarr:9696/api/v1/search?categories=2000,5000,8000
# NOTE: Prowlarr Torznab path differs; prefer Jackett for v1.
TORZNAB_URL=
TORZNAB_API_KEY=

# Comma-separated Jackett indexer ids, or "all". Examples (verify ids in Jackett UI):
# INDEXERS=1337x,thepiratebay,torrentgalaxy,nyaasi,yts
INDEXERS=all

# Trusted uploaders get a badge and bypass the 0-seed hide. Comma-separated, case-insensitive.
TRUSTED_UPLOADERS=

# Trust + quality defaults (grilled spec)
HIDE_ZERO_SEED=true
MAX_RESULTS=100

# Torznab fan-out
REQUEST_TIMEOUT_MS=12000
MAX_INDEXERS_PARALLEL=5

# Demo safety: 5-min cache, 30 req/min/IP
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MIN=30
DEMO_MODE=true
